    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"job_title\": {\n      \"type\": \"string\",\n      \"description\": \"The job title as stated in the job description. If not explicitly stated, infer the most likely title from the responsibilities described.\"\n    },\n    \"company\": {\n      \"type\": \"string\",\n      \"description\": \"The company name as stated in the job description. If not mentioned, return 'Unknown'.\"\n    },\n    \"match_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100,\n      \"description\": \"An overall match score from 0 to 100 representing how well the candidate's profile fits this job, based on skills, years of experience, education, and past roles.\"\n    },\n    \"recommendation\": {\n      \"type\": \"string\",\n      \"enum\": [\"Strong match\", \"Partial match\", \"Weak match\"],\n      \"description\": \"A categorical recommendation derived from match_score: 'Strong match' for a strong fit, 'Partial match' for a moderate fit with some gaps, 'Weak match' for significant gaps.\"\n    },\n    \"gaps_identified\": {\n      \"type\": \"string\",\n      \"description\": \"A short, comma-separated list or brief paragraph describing the specific skills, experience, or qualifications the candidate is missing relative to this job's requirements. Use 'None identified' if there are no notable gaps.\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"A 1-2 sentence explanation of why this match_score and recommendation were given.\"\n    }\n  },\n  \"required\": [\"job_title\", \"company\", \"match_score\", \"recommendation\", \"gaps_identified\"]\n}",
        "autoFix": true
      },
