      "parameters": {
        "promptType": "define",
        "text": "={{ $json.profile_id }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a job application matching assistant. You will be given a candidate's profile and a job description. Your task is to evaluate how well the candidate fits the job and return a structured analysis.  Scoring guidelines: - match_score should weigh required skills and years of experience most heavily, followed by education and past roles. - A \"Strong match\" (typically 75-100) means the candidate meets nearly all stated requirements. - A \"Partial match\" (typically 40-74) means the candidate meets core requirements but has some meaningful gaps. - A \"Weak match\" (typically 0-39) means the candidate is missing multiple key requirements. - Be honest and specific in gaps_identified. Do not inflate the score to be encouraging — the candidate is relying on this for real application decisions. - If the job description does not clearly state a company name or job title, infer the most reasonable value rather than leaving it blank.  Return only the structured fields. Do not add commentary outside the schema."
            },
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=CANDIDATE PROFILE: Name: {{ $json['name '] }} Skills: {{ $json.skills }} Years of experience: {{ $json.years_experience }} Education: {{ $json['education '] }} Past roles: {{ $json.past_roles }} JOB DESCRIPTION: {{ $('job_text').item.json.job_text }}  Evaluate the fit between this candidate and this job."
            }
          ]
        },
        "batching": {}
      },
