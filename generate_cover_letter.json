    {
      "parameters": {
        "jsCode": "// Read optional inputs from the trigger\nconst trigger = $('When Executed by Another Workflow').item.json;\nconst inputJobTitle = (trigger.job_title || '').trim().toLowerCase();\nconst inputCompany = (trigger.company || '').trim().toLowerCase();\n\n// All rows from the Google Sheets \"Get Applications Rows\" node feeding into this node\nconst rows = items.map(item => item.json);\n\nif (rows.length === 0) {\n  return [{ json: { status: 'not_found' } }];\n}\n\nlet matches;\n\nif (!inputJobTitle && !inputCompany) {\n  // No filters given -> \"most recent job\" = last row in the sheet\n  matches = [rows[rows.length - 1]];\n} else {\n  matches = rows.filter(row => {\n    const rowCompany = (row.company || '').toLowerCase();\n    const rowTitle = (row.job_title || '').toLowerCase();\n\n    const companyOk = inputCompany ? rowCompany.includes(inputCompany) : true;\n    const titleOk = inputJobTitle ? rowTitle.includes(inputJobTitle) : true;\n\n    return companyOk && titleOk;\n  });\n}\n\nif (matches.length === 0) {\n  return [{ json: { status: 'not_found' } }];\n}\n\nif (matches.length > 1) {\n  return [{\n    json: {\n      status: 'needs_clarification',\n      candidates: matches.map(row => ({\n        job_title: row.job_title,\n        company: row.company,\n        timestamp: row.timestamp,\n        decision: row.decision\n      }))\n    }\n  }];\n}\n\n// Exactly one match -> proceed\nconst target = matches[0];\n\nreturn [{\n  json: {\n    status: 'proceed',\n    row_number: target.row_number,\n    job_title: target.job_title,\n    company: target.company,\n    job_text: target.job_text,\n    decision: target.decision,\n    match_score: target.match_score\n  }\n}];"
      },
