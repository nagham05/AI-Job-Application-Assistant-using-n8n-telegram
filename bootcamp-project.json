          "value": {
            "job_title": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('job_title', `Optional. The job title the user wants a cover letter for, if they\nspecified one (e.g. \"backend engineer\"). Leave empty if the user didn't\nname a specific job — this defaults to the most recently analyzed job.\nPartial matches are fine; do not guess an exact title if the user was vague.`, 'string') }}",
            "company": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('company', `Optional. The company name the user wants a cover letter for, if they\nspecified one (e.g. \"Google\"). Leave empty if the user didn't name a\nspecific job — this defaults to the most recently analyzed job.\nPartial matches are fine (e.g. \"Google\" matches \"Google LLC\").`, 'string') }}"
